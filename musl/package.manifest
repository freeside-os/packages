[package]
name = "musl"
version = "1.2.6"
description = "musl C library (libc) implementation for Freeside"
dependencies = []
group = "base"

[[sources]]
url = "https://musl.libc.org/releases/musl-1.2.6.tar.gz"
checksum = { algorithm = "sha256", value = "d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a" }

[build]

[build.environment]
CONFIGURE_ARGS = "--prefix=/usr --syslibdir=/usr/lib"
dependencies = ["base-files"]
