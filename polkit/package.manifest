[package]
name = "polkit"
version = "127"
description = "Application development toolkit for controlling system-wide privileges"
group = "system"
dependencies = ["musl", "glib2", "libexpat", "systemd", "pam"]

[build]
dependencies = ["meson", "ninja", "pkgconf", "libexpat", "systemd", "make", "glib2", "pam"]

